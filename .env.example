APP_NAME="ReportFlow AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=reportflow
DB_USERNAME=reportflow
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=120

CACHE_STORE=redis
CACHE_PREFIX=reportflow_cache

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

GOTENBERG_URL=http://gotenberg:3000
PDF_RENDERER=gotenberg
OPS_PROBE=real
ADMIN_TELEGRAM_USER_ID=

# Telegram Bot (Pak Carik)
TELEGRAM_BOT_TOKEN=
# A-Z a-z 0-9 _ - (1-256 chars); registered with setWebhook, checked on every webhook request
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_SECRET_TOKEN=
# Unguessable webhook path segment, at least 32 chars of A-Z a-z 0-9 _ -  (e.g. from: openssl rand -hex 24)
TELEGRAM_WEBHOOK_PATH=
# "http" = real Bot API; "fake" is for tests only and refused in production
TELEGRAM_CLIENT=http
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-* (no wildcards); empty trusts none
TRUSTED_PROXIES=
# "deepseek" = real provider (needs DEEPSEEK_API_KEY); "fake" is for tests/dev only and refused in production
AI_PROVIDER=fake
# Who may use the bot: users.telegram_user_id (create with: php artisan reportflow:user:create)

# DeepSeek AI
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash

# Dev credentials for local seeder only (APP_ENV=local)
DEV_USER_EMAIL=
DEV_USER_PASSWORD=

# Backup (PRD §84). The encryption key file and rclone config live OUTSIDE the repository (./secrets is gitignored).
BACKUP_REMOTE=
BACKUP_CRON="0 19 * * *"
# BACKUP_KEY_FILE=./secrets/backup.key
# RCLONE_CONFIG_DIR=./secrets/rclone
