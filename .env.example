APP_NAME="ReportFlow AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=reportflow
DB_USERNAME=reportflow
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=120

CACHE_STORE=redis
CACHE_PREFIX=reportflow_cache

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

GOTENBERG_URL=http://gotenberg:3000

# Telegram Bot (Pak Carik)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_SECRET_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# DeepSeek AI
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash

# Dev credentials for local seeder only (APP_ENV=local)
DEV_USER_EMAIL=
DEV_USER_PASSWORD=
