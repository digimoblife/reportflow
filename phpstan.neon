includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/

    # Docker and CI run PHP 8.3; analyse against 8.3 even when a local PHP is newer.
    phpVersion: 80300

    # Level 5 is the starting baseline for Milestone M0.
    # Plan: gradually increase to level 8 in subsequent milestones (M1-M4)
    # as domain models, services, and strict types are implemented.
    level: 5
