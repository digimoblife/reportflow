{
  "$id": "worklog_extraction.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "clarification_needed"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intent", "project_id", "task_ref", "confidence", "matching_signals", "activity", "status_change", "people", "missing_details"],
        "properties": {
          "intent": {"type": "string", "enum": ["new_task", "update_existing_task"]},
          "project_id": {"type": ["integer", "null"]},
          "task_ref": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "task_id"],
                "properties": {"type": {"type": "string", "enum": ["existing"]}, "task_id": {"type": "integer", "minimum": 1}}
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "title"],
                "properties": {"type": {"type": "string", "enum": ["new"]}, "title": {"type": "string", "minLength": 3, "maxLength": 200}}
              }
            ]
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "matching_signals": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 100}},
          "activity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "summary", "date", "date_precision"],
            "properties": {
              "type": {"type": "string", "enum": ["request", "investigation", "development", "configuration", "bug_fix", "testing", "deployment", "communication", "research", "documentation", "milestone", "blocker", "resolution", "follow_up", "other"]},
              "summary": {"type": "string", "minLength": 3, "maxLength": 500},
              "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
              "date_precision": {"type": "string", "enum": ["day", "week", "month"]}
            }
          },
          "status_change": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to"],
                "properties": {
                  "from": {"type": ["string", "null"], "enum": ["draft", "open", "in_progress", "waiting", "blocked", "completed", "cancelled", null]},
                  "to": {"type": "string", "enum": ["draft", "open", "in_progress", "waiting", "blocked", "completed", "cancelled"]}
                }
              }
            ]
          },
          "people": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 100}},
          "missing_details": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 200}}
        }
      }
    },
    "clarification_needed": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["question"],
          "properties": {
            "question": {"type": "string", "minLength": 3, "maxLength": 500},
            "options": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 200}}
          }
        }
      ]
    }
  }
}
