# Production nginx: the config template and the public assets are baked in (no bind mounts).
# Build the app image first: `docker compose -f docker-compose.yml -f docker-compose.prod.yml build app nginx`.
ARG APP_IMAGE=reportflow-app:latest
FROM ${APP_IMAGE} AS app

FROM nginx:1.27-alpine
RUN rm -f /etc/nginx/conf.d/default.conf
COPY docker/nginx/prod.conf.template /etc/nginx/templates/prod.conf.template
COPY --from=app /var/www/html/public /var/www/html/public
