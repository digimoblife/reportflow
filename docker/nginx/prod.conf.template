# Production edge (PRD §56, M9e). Rendered by the nginx image's envsubst at container start into
# /etc/nginx/conf.d/prod.conf. Variables: APP_DOMAIN, TELEGRAM_WEBHOOK_PATH.
#
# - Port 80 only answers Let's Encrypt challenges and redirects to https://APP_DOMAIN (never to the Host header).
# - Port 443 serves APP_DOMAIN only; any other name (or an IP, or no SNI) gets its TLS handshake refused.
# - Do not add access_log/error_log to the webhook location: the request line contains the secret path.

# Rate limits. An empty key is not limited, so the map picks which requests count against "login".
map $uri $login_key {
    default "";
    ~^/auth/ $binary_remote_addr;
    ~^/admin/login $binary_remote_addr;
}
limit_req_zone $login_key zone=login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=general:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=perip:10m;
limit_req_status 429;
limit_conn_status 429;

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;

    location = /nginx-health { access_log off; default_type text/plain; return 200 "ok"; }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${APP_DOMAIN}$request_uri;
    }
}

# Anything that is not our domain: no certificate is ever shown.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};
    server_tokens off;

    root /var/www/html/public;
    index index.php;
    charset utf-8;

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/letsencrypt/live/${APP_DOMAIN}/chain.pem;
    # Docker's DNS (it also resolves external names for OCSP). A variable in fastcgi_pass makes nginx re-resolve `app`
    # instead of caching its IP at startup, so recreating the app container does not cause 502s.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    set $php_upstream app:9000;

    # No add_header in the locations below: they would replace these instead of adding to them.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    client_max_body_size 2m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    send_timeout 30s;

    limit_req zone=general burst=60 nodelay;
    limit_req zone=login burst=5 nodelay;
    limit_conn perip 30;

    # Telegram webhook: one exact path, POST only, and only with the secret header. Laravel verifies the header value.
    location = /${TELEGRAM_WEBHOOK_PATH} {
        access_log off;
        if ($request_method != POST) { return 404; }
        if ($http_x_telegram_bot_api_secret_token = "") { return 404; }

        client_max_body_size 1m;
        include fastcgi_params;
        fastcgi_pass $php_upstream;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTPS on;
        fastcgi_read_timeout 30;
    }

    location / {
        try_files $uri /index.php?$query_string;
    }

    # Only the front controller runs PHP.
    location ~ ^/index\.php(/|$) {
        include fastcgi_params;
        fastcgi_pass $php_upstream;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param HTTPS on;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 90;
    }

    location ~ \.php$ { return 404; }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
