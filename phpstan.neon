includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - database/

    # Docker and CI run PHP 8.3; analyse against 8.3 even when a local PHP is newer.
    phpVersion: 80300

    # M0 started at level 5; M1 raised it to 6. Plan: reach level 8 by M4.
    level: 6
